{
	auto_https off
}

(app) {
	encode gzip

	# Cap request bodies at the edge. The API accepts 64KB of JSON and 5MB uploads; anything
	# larger is rejected before it reaches Node.
	request_body {
		max_size 6MB
	}

	reverse_proxy api:8080 {
		# X-Forwarded-For is deliberately NOT copied from the client request. The previous
		# config passed `{http.request.header.X-Forwarded-For}` straight through, so any
		# caller could assert whatever client address they liked and walk through every
		# per-IP rate limit in the application. Omitting the directive restores Caddy's
		# default, which appends the real peer address to the chain.
		header_up X-Forwarded-Proto {http.request.scheme}
		# Shared secret so the API can reject anything that reached :8080 without
		# going through this reverse proxy (docker-network scanners, future Worker).
		# The live public path is Cloudflare Tunnel → this Caddy → Express.
		header_up X-Edge-Secret {$EDGE_SECRET}

		# Fail fast rather than holding connections open on a stalled upstream.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

:80 {
	import app
}

:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	import app
}
