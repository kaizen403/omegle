# Copy to deploy/.env and fill in. Never commit the filled file.

# ---- Domains / TLS ----
WEB_DOMAIN=chat.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=you@example.com

# ---- Postgres (internal; set a real password) ----
POSTGRES_USER=omegle
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=omegle
# The API's DATABASE_URL must point at the compose service name:
DATABASE_URL=postgresql://omegle:change-me-long-random@postgres:5432/omegle?sslmode=disable

# ---- Better Auth ----
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://chat.example.com

# ---- Redis (compose service name, not localhost) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false

# ---- Cloudflare Turnstile ----
TURNSTILE_SECRET_KEY=

# ---- S3 chat uploads / recording archive ----
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# ---- coturn ----
# Public IP of this machine; TURN_RELAY_IP is the private IP of the NIC
# used for relaying (on a cloud VM this is usually the internal IP).
TURN_PUBLIC_IP=203.0.113.10
TURN_RELAY_IP=10.0.0.5
TURN_AUTH_SECRET=change-me-coturn-auth-secret
TURN_REALM=omegle
# Must match TURN_PUBLIC_IP — clients receive this in ICE credentials
TURN_HOST=203.0.113.10

# ---- CORS: explicit origins only ----
ALLOWED_ORIGINS=https://chat.example.com,https://admin.example.com

# ---- Admin API ----
API_KEY=generate-another-long-random-string
JWT_SECRET=generate-a-third-long-random-string
JWT_EXPIRES_IN=30m
