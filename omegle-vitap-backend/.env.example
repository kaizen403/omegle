# Backend environment

PORT=8080
NODE_ENV=development

# Neon (use the pooled connection string)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080

# Cloudflare Turnstile (optional in development)
TURNSTILE_SECRET_KEY=

# Redis / ElastiCache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# S3 chat uploads
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Coturn (P2P ICE / TURN). TURN_HOST must be the public IP or DNS of this box.
TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=0
TURN_AUTH_SECRET=change-me-turn-auth-secret
TURN_REALM=omegle
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# CORS — explicit origins only (no *)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

API_KEY=
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=30m
