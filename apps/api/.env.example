# Backend environment

PORT=8080
NODE_ENV=development
# Winston level: error | warn | info | http | verbose | debug. Default info if unset.
# Production compose.yml sets LOG_LEVEL=debug so handshake/join failures show in docker logs.
LOG_LEVEL=info

# Neon (use the pooled connection string)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080

# Cloudflare Turnstile (optional in development)
TURNSTILE_SECRET_KEY=

# Redis / ElastiCache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# Coturn / Cloudflare Realtime TURN (P2P ICE).
# For Cloudflare (TURN_HOST=turn.cloudflare.com) the secret MUST be "{keyId}:{apiToken}".
# A value without a colon silently disables TURN, which breaks video for anyone behind
# CGNAT. Production refuses to boot on a malformed value.
# TURN_TLS_PORT=443 is strongly recommended for coturn: TURN over TLS on 443 is the only
# path that works on networks blocking UDP (much campus wifi, many mobile carriers). Left at
# 0 those users get no video and no error. Cloudflare TURN provides this itself.
TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=0
TURN_AUTH_SECRET=change-me-turn-auth-secret
TURN_REALM=omegle
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# CORS — explicit origins only (no *).
# A `*.example.com` entry matches subdomains only, never `evilexample.com`.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Secrets. In production API_KEY must be >=24 chars and JWT_SECRET/BETTER_AUTH_SECRET >=32;
# placeholder values are rejected at boot. Generate with: openssl rand -base64 48
API_KEY=
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=30m

# ---------------------------------------------------------------------------
# Abuse and cost controls
# ---------------------------------------------------------------------------

# Which proxies may set X-Forwarded-For / CF-Connecting-IP. Without this, forwarded headers
# are ignored and every request is attributed to the peer address — which means per-IP limits
# would bucket all Cloudflare traffic together.
#   cloudflare  -> Cloudflare's published edge ranges
#   private     -> RFC1918 + loopback (the Caddy sidecar)
# Behind Cloudflare + Caddy this should be: cloudflare,private
TRUSTED_PROXIES=private

# Shared secret the edge must send as X-Edge-Secret. When set, requests that did not come
# through the Cloudflare Worker are refused, so the origin IP cannot be used to bypass the
# CDN's WAF and rate limiting. Must match `wrangler secret put EDGE_SECRET`.
EDGE_SECRET=

# Capacity and abuse ceilings (all optional; defaults shown).
#
# NOTE ON PER-IP LIMITS: essentially the whole user base arrives from a few campus and
# carrier NAT addresses, so a tight per-IP cap locks out real students rather than isolating
# an abuser. A load test of 1,000 clients from one address was refused at a cap of 400.
# MAX_TOTAL_SOCKETS is the ceiling that actually protects the process.
MAX_TOTAL_SOCKETS=6000
MAX_SOCKETS_PER_IP=3000
MAX_HANDSHAKES_PER_IP_PER_MIN=4000
MAX_JOINS_PER_IP_PER_MIN=1500
MAX_MESSAGES_PER_IP_PER_MIN=6000

# Queue drain rate. 10-per-2s capped matchmaking at 5 users/second regardless of demand,
# which left a launch surge waiting minutes.
MATCHMAKER_TICK_MS=500
MATCHMAKER_BATCH=150

# Global spend ceilings per rolling hour, across all users. These bound the bill for metered
# third-party services that user activity can trigger.
MAX_BOT_REPLIES_PER_HOUR=2000
MAX_GEO_LOOKUPS_PER_HOUR=500

# Server-only key for /metrics and /health/details. MUST differ from API_KEY, which is
# published to browsers as NEXT_PUBLIC_API_KEY. Leave empty to disable those endpoints.
INTERNAL_API_KEY=
