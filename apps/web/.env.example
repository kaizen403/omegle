# ===========================================
# Omegle VITAP - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# ===========================================

# Application Mode
# Set to 'true' to enable maintenance mode (redirects all traffic to maintenance page)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ===========================================
# Backend Configuration
# ===========================================

# Backend Socket.IO server URL
# Development: http://localhost:8080
# Production: https://omeagle-backend-1079560721492.asia-south1.run.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# API key for backend authentication
NEXT_PUBLIC_API_KEY=your-api-key-here

# ===========================================
# PostHog Analytics Configuration
# ===========================================
# Get these values from your PostHog project:
# Project Settings > Project ID / API Key

# PostHog Project API Key (required for analytics)
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API Host (optional - defaults to https://us.i.posthog.com)
# Use https://eu.i.posthog.com for EU Cloud, or your self-hosted URL
NEXT_PUBLIC_POSTHOG_HOST=
